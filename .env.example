# Which model answers is plain config, via litellm, independent of
# everything else in this repo. Point this at a local OpenAI-compatible
# endpoint (llama-server/ollama/vllm) or a hosted one.
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=openai/your-model-name-here
# Leave blank for a bare local llama-server/ollama/vllm instance on
# 127.0.0.1, which takes no auth. Set it when LLM_BASE_URL is a
# remote-exposed endpoint behind a reverse proxy/Tailscale Funnel that
# requires Bearer auth.
LLM_API_KEY=

# A local/self-hosted model answers much slower than a hosted frontier
# API -- size these to the real observed latency of your endpoint, not
# litellm's defaults. LLM_MAX_OUTPUT_TOKENS needs real headroom for a
# reasoning model: hidden reasoning_content counts against this budget
# before any visible output, and too tight a cap here causes a silently
# truncated turn (see tradecraft/execution/loop.py's truncation-retry logic,
# which exists as a safety net, not a substitute for sizing this right).
LLM_DECIDER_TIMEOUT=480
LLM_MAX_OUTPUT_TOKENS=16384

# The model's real context window. Resolution order (tradecraft/execution/
# budget.py's resolve_context_window): this value if set -> litellm's own
# model database (works for a hosted model it recognizes, e.g. gpt-4o ->
# 128000) -> 128000 as a conservative fallback if neither resolves. Set
# this explicitly for a self-hosted model litellm has no entry for
# (confirmed for real: qwen3.8-27b raises ModelNotMappedError) --
# confirm the real number against the model's own published spec.
# LLM_CONTEXT_WINDOW=262144

# Three separate token budgets (tradecraft/execution/budget.py), so growth in
# one doesn't silently starve the others or blow the model's real context
# window. Every overflow is trimmed from the oldest end with an explicit
# marker -- nothing is ever silently dropped.
#   HISTORY and FACTS are rendered in full every turn; trimming only
#            engages on genuine overflow against the total budget below,
#            in a fixed sacrifice order (CONVERSATION, then HISTORY, then
#            FACTS last) -- see tradecraft/execution/budget.py.
#   CONVERSATION: optional explicit cap on tool-call/result history.
#            0 (default) = elastic: claims whatever headroom remains under
#            total budget. Set > 0 (e.g. 20000) to keep turns fast and cheap.
#   total:   derived from LLM_CONTEXT_WINDOW - LLM_MAX_OUTPUT_TOKENS -
#            a fixed safety margin.
TRADECRAFT_CONVERSATION_TOKEN_BUDGET=0


# Tradecraft's own loop concept, not an LLM deployment detail: hard upper
# bound on tool-call turns per engagement before the loop forces a final
# report instead of running forever. 0 (or unset) = unlimited -- the
# model runs until it stops calling tools on its own.
TRADECRAFT_MAX_TURNS=0

# GitHub personal access token for gitdorker tool.
# A free PAT (no special scopes needed) for querying GitHub's code search API.
# If unset, gitdorker is automatically excluded from the engagement.
GITHUB_TOKEN=

# Shodan API key (paid tier -- favicon-hash search is not part of the
# free internetdb.shodan.io API shodan_internetdb already uses) for
# favicon_correlator. If unset, favicon_correlator is automatically
# excluded from the engagement.
SHODAN_API_KEY=

# Optional neural embedding model (via litellm.embedding) for cross-engagement
# hybrid memory (`$TRADECRAFT_HOME/memory.db`). Leave blank to use the built-in
# offline FTS5 BM25 + local n-gram vector search with zero external dependencies.
# LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
# LLM_EMBEDDING_BASE_URL=
# LLM_EMBEDDING_API_KEY=
